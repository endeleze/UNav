    "        for axis in axes:\n",
    "            for label in output['labels']:\n",
    "                d[str(axis)+label.replace(' ','')] = output[\"features\"][idx]\n",
    "                idx += 1\n",
    "        return d\n",
    "    return __get_dict_of_extracted_features( output )\n"
   ]
  },
