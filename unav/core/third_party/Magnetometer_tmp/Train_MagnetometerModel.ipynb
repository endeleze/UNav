   "source": [
    "def parse_reference_location_samples_to_multifeature_output( dft, funcs, kwargs_array, batch_size, features, targets ) -> pd.DataFrame:\n",
    "    batches = np.array_split(dft, len(dft) // batch_size)\n",
    "    r = []\n",
    "    d_target = {k:v for k,v in zip(targets, batches[0].iloc[0][targets]) }\n",
    "    for b in batches:\n",
    "        tmp = {}\n",
    "        \n",
    "        for func, args in zip(funcs, kwargs_array):\n",
    "            f_str = ''\n",
    "            b2 = None\n",
    "            if args is None:\n",
    "                f_str = func.__name__\n",
    "                b2 = func(b[features])\n",
    "                tmp = tmp | {f'{k}_{f_str}':v for k,v in zip(features,b2)}\n",
    "            else:\n",
    "                b2 = func(b[features], **args)\n",
    "            if type(b2) is dict:\n",
    "                for k in b2.keys():\n",
    "                    f_str += f'_{k}'\n",
    "                    tmp = tmp | {f'{k}':b2[k]}\n",
    "            elif args is not None:\n",
    "                f_str = func.__name__\n",
    "                for k,v in args.items():\n",
    "                    f_str += f'_{k}{v}'\n",
    "                tmp = tmp | {f'{k}_{f_str}':v for k,v in zip(features,b2)}\n",
    "\n",
    "        r += [ tmp | d_target ]\n",
    "        \n",
    "    return pd.DataFrame.from_records(r)\n",
    "\n",
    "def compile_aggregated_batched_df( df, ref_points, \n",
    "                           sample_size,\n",
    "                           funcs=[np.median],\n",
    "                           kwargs_array=None,\n",
    "                           features=['X','Y','Z'], \n",
    "                           targets=['Cx','Cy'], \n",
    "                           batch_size=100,\n",
    "                           random_sample=True):\n",
    "    dfrs = []\n",
    "    for i,(l) in enumerate(ref_points):\n",
    "        dft = None\n",
    "        if random_sample:\n",
    "            dft = df[df['label']==l].sample(n=sample_size) # Stratify dataset.\n",
    "        else:\n",
    "            dft = df[df['label']==l][0:sample_size]\n",
    "        dfr = parse_reference_location_samples_to_multifeature_output( dft.copy(), funcs, kwargs_array, batch_size, features, targets )\n",
    "        # display(dfr)\n",
    "        print(f'#{i}\\t', f'\\tLabel: {l}', f'Preprocess-size: {len(dft)}', f'Postprocess-size: {len(dfr)}')\n",
    "        dfrs += [dfr]\n",
    "    dfr = pd.concat( dfrs )\n",
    "    return dfr\n",
    "\n",
    "training_df = None\n",
    "with warnings.catch_warnings():\n",
    "    warnings.simplefilter(action='ignore', category=FutureWarning)\n",
    "    training_df = compile_aggregated_batched_df( dfr, ref_points, sample_size,\n",
    "                               funcs=functions,\n",
    "                               kwargs_array=args_set,\n",
    "                               # features=features, \n",
    "                               # targets=targets, \n",
    "                               batch_size=batch_size,\n",
    "                                random_sample=random_sample) "
   ]
  },
